+static bool ggml_sycl_decode_only_graphs() {
+    static const bool enabled = []() {
+        const char * value = std::getenv("GGML_SYCL_GRAPH_DECODE_ONLY");
+        if (!value || std::strcmp(value, "0") == 0) {
+            return false;
+        }
+        GGML_ASSERT(std::strcmp(value, "1") == 0);
+        return true;
+    }();
+    return enabled;
+}
+
+static bool ggml_sycl_has_multi_token_matmul(const ggml_cgraph * cgraph) {
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (node->op == GGML_OP_MUL_MAT && node->src[1] && node->src[1]->ne[1] > 1) {
+            return true;
+        }
+    }
+    return false;
+}
